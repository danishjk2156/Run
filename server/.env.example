# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://relay:relay@localhost:5432/touchgrass

# Redis
REDIS_URL=redis://localhost:6379

# Room settings
ROOM_CODE_LENGTH=6
ROOM_MAX_MEMBERS=20
ROOM_LOBBY_TTL_MINUTES=30

# GPS filters
GPS_MAX_ACCURACY_M=25
GPS_MAX_SPEED_KMH=25
GPS_MIN_MOVEMENT_M=3
GPS_MAX_JUMP_M=500
GPS_MIN_INTERVAL_S=3

# Tier thresholds (overridden by room's custom target)
TIER_BASE_TARGET_KM=50
